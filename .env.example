DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
PORT=3001

# SMTP (Gmail recommended — use an App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Paw-M Clinic
SMTP_FROM_ADDR=Paw-M Clinic <your-email@gmail.com>

# NOTE: All other settings (currency symbol, InstaPay account, clinic info)
# are stored in the database via the ClinicSettings model and edited from
# the dashboard Settings tab — no env vars needed for them.
# ── Database ──────────────────────────────────────────────────────────────────
# DigitalOcean Managed PostgreSQL (defaultdb, port 25060) — example format:
DATABASE_URL="postgresql://USER:PASSWORD@DB-HOST-do-user-DIGITS-0.e.db.ondigitalocean.com:25060/defaultdb?sslmode=require"

# Connection timeouts. These are applied in code (src/lib/db-url.js) and are only
# listed here for overriding; a deployment works without setting any of them.
# Note the mixed units — this is not a typo, it mirrors how the driver expects them.
# Seconds: connect_timeout (dialing), pool_timeout (waiting for a free
# connection), socket_timeout (no data returned mid-query).
DB_CONNECT_TIMEOUT_SEC=10
DB_POOL_TIMEOUT_SEC=10
DB_SOCKET_TIMEOUT_SEC=30
# Milliseconds, enforced server side via libpq `options`. Prisma ignores a
# top-level statement_timeout DSN parameter, so it must go through that route.
DB_STATEMENT_TIMEOUT_MS=15000
# Max pooled connections. Keep well under the database's max_connections.
DB_CONNECTION_LIMIT=10
# Budget for the SELECT 1 behind GET /api/ready before it reports 503. Measured
# against the DO pooler: ~100-200ms warm, ~1.5s on a cold connection, so 5s keeps
# ample headroom while still failing far sooner than the platform's ~30s timeout.
DB_HEALTH_TIMEOUT_MS=5000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string-in-production
JWT_EXPIRES_IN=8h
COOKIE_NAME=paw-m-session
# Double-submit CSRF cookie used when a staff session is authenticated via cookie.
CSRF_COOKIE_NAME=paw-m-csrf-token
# Only set for throwaway local dev when JWT_SECRET is left at the default value.
ALLOW_INSECURE_DEV_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=100
RATE_LIMIT_SENSITIVE_MAX=30

# ── Body Limit ────────────────────────────────────────────────────────────────
BODY_LIMIT=8mb

# ── SMTP (Gmail recommended — use an App Password, not your real password) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Paw-M Clinic
SMTP_FROM_ADDR=Paw-M Clinic <your-email@gmail.com>

# ── Notes ─────────────────────────────────────────────────────────────────────
# Clinic settings (currency, phone, address, etc.) are stored in the database
# via the ClinicSettings model and edited from the dashboard Settings tab.

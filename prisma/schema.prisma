// Prisma schema for Paw-M (veterinary clinic management) — v2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum OrderStatus {
  pending
  confirmed
  completed
  cancelled
}

enum PaymentMethod {
  cash
  fawry
  instapay
}

enum PaymentStatus {
  unpaid
  proof_submitted
  paid
}

enum StaffRole {
  admin
  payroll
  staff
}

model Booking {
  id          String        @id @default(cuid())
  clientId    String?
  ownerName   String
  phone       String
  email       String
  petName     String
  animalType  String
  breed       String
  age         String
  weight      String
  symptoms    String
  allergies   String
  medications String
  doctorId    String
  doctorName  String
  date        String
  time        String
  emergency   Boolean       @default(false)
  status      BookingStatus @default(pending)
  archived    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([date, doctorId])
  @@index([status])
  @@index([archived])
}

model Doctor {
  id             String   @id
  name           String
  specialization String
  experience     String
  rating         Float
  days           String[]
  bio            String
  initials       String
  tags           String[]
  pets           String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Service {
  slug        String   @id
  icon        String
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClinicSettings {
  id              Int      @id @default(1)
  name            String
  tagline         String
  phone           String
  emergency       String
  whatsapp        String
  email           String
  address         String
  currency        String   @default("EGP")
  instapay        String   @default("")
  googlePlacesKey String   @default("")
  googlePlacesId  String   @default("")
  updatedAt       DateTime @updatedAt
}

model AdminUser {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  salt      String
  hash      String
  role      StaffRole  @default(staff)
  createdAt DateTime   @default(now())
}

model ClientAccount {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  salt         String
  fullName     String
  phone        String          @default("")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     ClientSession[]
}

model ClientSession {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  clientId  String
  client    ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([clientId, expiresAt])
}

model ClientVerification {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  salt         String
  fullName     String
  phone        String   @default("")
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

model Employee {
  id              String    @id @default(cuid())

  fullName        String
  email           String    @unique
  phone           String?
  avatarUrl       String    @default("")
  color           String    @default("#4F46E5")

  role            StaffRole @default(staff)
  payRateType     String    @default("hourly") // hourly | monthly
  hourlyRate      Float     @default(0)
  monthlySalary   Float     @default(0)
  roleHoursPerDay Int       @default(8)

  // Commission rates per service category: {"spay-neuter": 10, "dental": 8, ...} (% of revenue)
  commissionRates Json      @default("{}")

  isActive        Boolean   @default(true)

// Relations
  tasks              AdminTask[]
  workSessions       WorkSession[]
  payrollRecords     PayrollRecord[]
  notifications      Notification[]
  bonusDedRequests   BonusDeductionRequest[] @relation("EmployeeBonusDeductions")

  createdAt          DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  author    String
  rating    Int
  comment   String
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())

  @@index([productId, status])
  @@index([status])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String
  price          Float
  compareAtPrice Float?
  image          String
  category       String
  petType        String   @default("both") // dog | cat | both
  stock          Int      @default(0)
  minStockAlert  Int      @default(5)     // trigger low-stock alert below this
  featured       Boolean  @default(false)
  barcode        String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@index([stock])
  @@index([barcode])
}

model Order {
  id            String        @id @default(cuid())
  clientId      String?
  customerName  String
  phone         String
  email         String
  address       String
  items         Json
  total         Float
  status        OrderStatus   @default(pending)
  paymentMethod PaymentMethod @default(cash)
  paymentStatus PaymentStatus @default(unpaid)
  paymentRef    String        @default("")
  proofImage    String        @default("")
  paidAt        DateTime?
  archived      Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@index([status])
  @@index([paymentStatus])
  @@index([archived])
}

model Payment {
  id        String        @id @default(cuid())
  title     String
  amount    Float
  method    PaymentMethod @default(cash)
  status    PaymentStatus @default(unpaid)
  date      String
  notes     String        @default("")
  orderId   String        @default("")
  createdAt DateTime      @default(now())

  @@index([status])
  @@index([date])
}

model WorkSession {
  id              String   @id @default(cuid())

  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])

  date            String          // YYYY-MM-DD
  startedAt       DateTime        @default(now())
  endedAt         DateTime?

  // Auto-counted at check-out
  bookingsCount   Int             @default(0)
  ordersCount     Int             @default(0)
  revenueTotal    Float           @default(0)
  commissionTotal Float           @default(0)

  paySnapshot     Json?           // {basePay, commissionPay, bonuses, deductions, netPay}
  isPaid          Boolean         @default(false)

  createdAt       DateTime        @default(now())

  @@index([employeeId, date])
  @@index([date])
}

model PayrollRecord {
  id              String   @id @default(cuid())

  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])

  periodStart     String   // YYYY-MM-DD
  periodEnd       String   // YYYY-MM-DD

  totalSessions   Int
  totalHours      Float
  totalBookings   Int
  totalOrders     Int
  totalRevenue    Float

  basePay         Float
  commissionPay   Float    @default(0)
  totalBonuses    Float    @default(0)
  totalDeductions Float    @default(0)
  netPay          Float

  status          String   @default("calculated") // calculated | pending_approval | approved | paid | rejected

  calculatedBy    String   // payroll username who created it
  approvedBy      String?
  approvedAt      DateTime?
  paidAt          DateTime?

  notes           String        @default("")
  breakdown       Json          // [{sessionId, date, hours, bookings, orders, revenue, basePay, commission}]
  bonusDeductionRequests BonusDeductionRequest[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([employeeId, periodStart, periodEnd])
  @@index([status])
}

model BonusDeductionRequest {
  id              String  @id @default(cuid())

  type            String  // "bonus" | "deduction"
  employeeId      String
  employee        Employee @relation("EmployeeBonusDeductions", fields: [employeeId], references: [id])
  payrollRecordId String
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)

  amount          Float
  reason          String
  status          String  @default("pending") // pending | approved | rejected

  workSessionId   String?

  requestedBy     String
  reviewedBy      String?
  reviewedAt      DateTime?
  adminComment    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([employeeId, status])
  @@index([payrollRecordId])
}

model AdminTask {
  id              String   @id @default(cuid())

  title           String
  description     String?
  priority        String   @default("medium") // low | medium | high | urgent
  status          String   @default("open")   // open | in_progress | completed | cancelled
  dueDate         String?  // YYYY-MM-DD

  assignedBy      String
  assignedToId    String
  assignedTo      Employee @relation(fields: [assignedToId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([assignedToId, status])
  @@index([status])
}

model Notification {
  id           String   @id @default(cuid())

  type         String   // payroll | task | system | approval | broadcast
  title        String
  body         String
  data         Json?    // {payrollRecordId, taskId, amount, ...}

  targetUserId String?
  target       Employee? @relation(fields: [targetUserId], references: [id])

  readBy       Json     // array of employee IDs who read it

  createdAt    DateTime @default(now())

  @@index([targetUserId])
  @@index([type])
}

model StockMovement {
  id              String   @id @default(cuid())

  productId       String
  productName     String   // denormalized for history integrity

  type            String   // sale | restock | damage | return | adjustment
  qtyChange       Int      // negative = out, positive = in
  qtyBefore       Int
  qtyAfter        Int

  relatedOrderId  String   @default("")
  note            String   @default("")
  changedBy       String   // username

  createdAt       DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  target    String   @default("")
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
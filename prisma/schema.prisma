// Prisma schema for Paw-M (veterinary clinic management)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum OrderStatus {
  pending
  confirmed
  completed
  cancelled
}

enum PaymentMethod {
  cash
  fawry
  instapay
}

enum PaymentStatus {
  unpaid
  proof_submitted
  paid
}

model Booking {
  id          String        @id @default(cuid())
  ownerName   String
  phone       String
  email       String
  petName     String
  animalType  String
  breed       String
  age         String
  weight      String
  symptoms    String
  allergies   String
  medications String
  doctorId    String
  doctorName  String
  date        String
  time        String
  emergency   Boolean       @default(false)
  status      BookingStatus @default(pending)
  archived    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([date, doctorId])
  @@index([status])
  @@index([archived])
}

model Doctor {
  id             String   @id
  name           String
  specialization String
  experience     String
  rating         Float
  days           String[]
  bio            String
  initials       String
  tags           String[]
  pets           String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Service {
  slug        String   @id
  icon        String
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClinicSettings {
  id        Int      @id @default(1)
  name      String
  tagline   String
  phone     String
  emergency String
  whatsapp  String
  email     String
  address   String
  currency  String   @default("$")
  instapay  String   @default("")
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  salt      String
  hash      String
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  productId String
  author    String
  rating    Int
  comment   String
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())

  @@index([productId, status])
  @@index([status])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String
  price          Float
  compareAtPrice Float?
  image          String
  category       String
  petType        String   @default("both") // dog | cat | both
  stock          Int      @default(0)
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([featured])
}

model Order {
  id            String        @id @default(cuid())
  customerName  String
  phone         String
  email         String
  address       String
  items         Json
  total         Float
  status        OrderStatus   @default(pending)
  paymentMethod PaymentMethod @default(cash)
  paymentStatus PaymentStatus @default(unpaid)
  paymentRef    String        @default("")
  proofImage    String        @default("")
  paidAt        DateTime?
  archived      Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@index([status])
  @@index([paymentStatus])
  @@index([archived])
}

model Payment {
  id        String        @id @default(cuid())
  title     String
  amount    Float
  method    PaymentMethod @default(cash)
  status    PaymentStatus @default(unpaid)
  date      String
  notes     String        @default("")
  orderId   String        @default("")
  createdAt DateTime      @default(now())

  @@index([status])
  @@index([date])
}

model WorkSession {
  id        String   @id @default(cuid())
  startedAt DateTime @default(now())
  endedAt   DateTime?
  date      String
  createdAt DateTime @default(now())

  @@index([date])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  target    String   @default("")
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
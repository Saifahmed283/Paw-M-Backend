// Prisma schema for Paw-M (veterinary clinic management) — v2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum OrderStatus {
  pending
  confirmed
  completed
  cancelled
}

enum PaymentMethod {
  cash
  fawry
  instapay
}

enum PaymentStatus {
  unpaid
  proof_submitted
  under_review
  paid
  rejected
}

enum StaffRole {
  admin
  payroll
  staff
}

model Booking {
  id              String        @id @default(cuid())
  clientId        String?
  client          ClientAccount? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  petId           String?
  pet             Pet?          @relation(fields: [petId], references: [id], onDelete: SetNull)
  ownerName       String
  phone           String
  email           String
  petName         String
  animalType      String
  breed           String
  age             String
  weight          String
  symptoms        String
  allergies       String
  medications     String
  doctorId        String
  doctorName      String
  date            String
  time            String
  emergency       Boolean       @default(false)
  diagnosis       String        @default("")
  treatmentNotes  String        @default("")
  followUpDate    String        @default("")
  status          BookingStatus @default(pending)
  archived        Boolean       @default(false)
  createdAt       DateTime      @default(now())

  prescriptions  Prescription[]
  payments       Payment[]

  @@index([date, doctorId])
  @@index([status])
  @@index([archived])
  @@index([clientId])
  @@index([petId])
}

model Doctor {
  id             String   @id
  name           String
  specialization String
  experience     String
  rating         Float
  days           String[]
  bio            String
  initials       String
  tags           String[]
  pets           String[]
  title          String   @default("")
  licenseNumber  String   @default("")
  signatureImage String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prescriptions  Prescription[]
}

model Service {
  slug        String   @id
  icon        String
  title       String
  description String
  price       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClinicSettings {
  id              Int      @id @default(1)
  name            String
  tagline         String
  phone           String
  emergency       String
  whatsapp        String
  email           String
  address         String
  currency        String   @default("EGP")
  instapay        String   @default("")
  googlePlacesKey String   @default("")
  googlePlacesId  String   @default("")
  rolePermissions Json     @default("{}")
  updatedAt       DateTime @updatedAt
}

model AdminUser {
  id         Int        @id @default(autoincrement())
  username   String     @unique
  salt       String
  hash       String
  role       StaffRole  @default(staff)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())

  // Explicit link to the Employee used for check-in / payroll attribution.
  // Legacy accounts stay null until backfilled (username -> email lookup).
  employeeId String?    @unique
  employee   Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  paymentVerifications PaymentVerification[]
  cashDrawerCloses     CashDrawerClose[]
}

model ClientAccount {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  salt         String
  fullName     String
  phone        String          @default("")
  suspended    Boolean         @default(false)
  suspendedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     ClientSession[]
  pets         Pet[]
  bookings     Booking[]
  orders       Order[]
  payments     Payment[]
  prescriptions Prescription[]
  notifications ClientNotification[]
}

model ClientNotification {
  id        String        @id @default(cuid())
  clientId  String
  client    ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  body      String
  isRead    Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([clientId, isRead])
}

model ClientSession {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  clientId  String
  client    ClientAccount @relation(fields: [clientId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([clientId, expiresAt])
}

model ClientVerification {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  salt         String
  fullName     String
  phone        String   @default("")
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

model Employee {
  id              String    @id @default(cuid())

  fullName        String
  email           String    @unique
  phone           String?
  avatarUrl       String    @default("")
  color           String    @default("#4F46E5")

  role            StaffRole @default(staff)
  payRateType     String    @default("hourly") // hourly | monthly
  hourlyRate      Float     @default(0)
  monthlySalary   Float     @default(0)
  roleHoursPerDay Int       @default(8)

  // Commission rates per service category: {"spay-neuter": 10, "dental": 8, ...} (% of revenue)
  commissionRates Json      @default("{}")

  isActive        Boolean   @default(true)

// Relations
  adminAccount       AdminUser?
  tasks              AdminTask[]
  workSessions       WorkSession[]
  payrollRecords     PayrollRecord[]
  notifications      Notification[]
  bonusDedRequests   BonusDeductionRequest[] @relation("EmployeeBonusDeductions")

  createdAt          DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  author    String
  rating    Int
  comment   String
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())

  @@index([productId, status])
  @@index([status])
}

model Product {
  id             String   @id @default(cuid())
  name           String
  description    String
  price          Float
  compareAtPrice Float?
  image          String
  category       String
  petType        String   @default("both") // dog | cat | both
  stock          Int      @default(0)
  minStockAlert  Int      @default(5)     // trigger low-stock alert below this
  featured       Boolean  @default(false)
  barcode        String?  @unique
  barcodeImage   String?  @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@index([stock])
  @@index([barcode])
}

model Order {
  id            String        @id @default(cuid())
  clientId      String?
  client        ClientAccount? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  customerName  String
  phone         String
  email         String
  address       String
  items         Json
  total         Float
  status        OrderStatus   @default(pending)
  paymentMethod PaymentMethod @default(cash)
  paymentStatus PaymentStatus @default(unpaid)
  paymentRef    String        @default("")
  proofImage    String        @default("")
  paidAt        DateTime?
  archived      Boolean       @default(false)
  source        String        @default("store")
  discountAmount Float        @default(0)
  discountLabel  String       @default("")
  createdAt     DateTime      @default(now())

  verifications PaymentVerification[]

  @@index([status])
  @@index([paymentStatus])
  @@index([archived])
  @@index([source])
}

/// Immutable audit trail of how an order payment was verified. Only trusted
/// verification events (POS cash reception, staff cash confirmation, or admin
/// transfer approval) may set an order's paymentStatus to "paid".
model PaymentVerification {
  id                       String        @id @default(cuid())
  orderId                  String
  order                    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId                String?
  method                   PaymentMethod
  amount                   Float
  source                   String // customer_transfer | cash_reception
  customerRef              String        @default("")
  senderName               String        @default("")
  transferredAt            DateTime?
  evidenceKey              String        @default("") // private object-storage key; never exposed to customers
  note                     String        @default("")
  decision                 String        @default("submitted") // submitted | under_review | approved | rejected | superseded
  bankTransactionReference String?       @unique
  reviewerId               Int?
  reviewer                 AdminUser?    @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt               DateTime?
  createdAt                DateTime      @default(now())

  @@index([orderId])
  @@index([decision])
}

/// Per-day cash drawer reconciliation (expected vs counted).
model CashDrawerClose {
  id        String    @id @default(cuid())
  date      String // YYYY-MM-DD (clinic day)
  expected  Float
  counted   Float
  variance  Float
  countedBy     Int
  countedByUser AdminUser @relation(fields: [countedBy], references: [id])
  note      String    @default("")
  createdAt DateTime  @default(now())

  @@index([date])
}

model Payment {
  id          String        @id @default(cuid())
  title       String
  amount      Float
  method      PaymentMethod @default(cash)
  status      PaymentStatus @default(unpaid)
  date        String
  notes       String        @default("")
  orderId     String        @default("")
  clientId    String?
  client      ClientAccount? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  bookingId   String?
  booking     Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  kind        String        @default("order") // order | visit | manual
  requestedBy String        @default("")
  createdAt   DateTime      @default(now())

  items PaymentItem[]

  @@index([status])
  @@index([date])
  @@index([kind])
  @@index([clientId])
  @@index([bookingId])
}

model PaymentItem {
  id          String  @id @default(cuid())
  paymentId   String
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  label       String
  amount      Float
  kind        String  @default("service") // service | product | other
  referenceId String  @default("")
  createdAt   DateTime @default(now())

  @@index([paymentId])
}

model WorkSession {
  id              String   @id @default(cuid())

  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])

  date            String          // YYYY-MM-DD
  startedAt       DateTime        @default(now())
  endedAt         DateTime?

  // Auto-counted at check-out
  bookingsCount   Int             @default(0)
  ordersCount     Int             @default(0)
  revenueTotal    Float           @default(0)
  commissionTotal Float           @default(0)

  paySnapshot     Json?           // {basePay, commissionPay, bonuses, deductions, netPay}
  isPaid          Boolean         @default(false)

  createdAt       DateTime        @default(now())

  @@index([employeeId, date])
  @@index([date])
}

model PayrollRecord {
  id              String   @id @default(cuid())

  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])

  periodStart     String   // YYYY-MM-DD
  periodEnd       String   // YYYY-MM-DD

  totalSessions   Int
  totalHours      Float
  totalBookings   Int
  totalOrders     Int
  totalRevenue    Float

  basePay         Float
  commissionPay   Float    @default(0)
  totalBonuses    Float    @default(0)
  totalDeductions Float    @default(0)
  netPay          Float

  status          String   @default("calculated") // calculated | pending_approval | approved | paid | rejected

  calculatedBy    String   // payroll username who created it
  approvedBy      String?
  approvedAt      DateTime?
  paidAt          DateTime?

  notes           String        @default("")
  breakdown       Json          // [{sessionId, date, hours, bookings, orders, revenue, basePay, commission}]
  bonusDeductionRequests BonusDeductionRequest[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([employeeId, periodStart, periodEnd])
  @@index([status])
}

model BonusDeductionRequest {
  id              String  @id @default(cuid())

  type            String  // "bonus" | "deduction"
  employeeId      String
  employee        Employee @relation("EmployeeBonusDeductions", fields: [employeeId], references: [id])
  payrollRecordId String
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)

  amount          Float
  reason          String
  status          String  @default("pending") // pending | approved | rejected

  workSessionId   String?

  requestedBy     String
  reviewedBy      String?
  reviewedAt      DateTime?
  adminComment    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([employeeId, status])
  @@index([payrollRecordId])
}

model AdminTask {
  id              String   @id @default(cuid())

  title           String
  description     String?
  priority        String   @default("medium") // low | medium | high | urgent
  status          String   @default("open")   // open | in_progress | completed | cancelled
  dueDate         String?  // YYYY-MM-DD

  assignedBy      String
  assignedToId    String
  assignedTo      Employee @relation(fields: [assignedToId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([assignedToId, status])
  @@index([status])
}

model Notification {
  id           String   @id @default(cuid())

  type         String   // payroll | task | system | approval | broadcast
  title        String
  body         String
  data         Json?    // {payrollRecordId, taskId, amount, ...}

  targetUserId String?
  target       Employee? @relation(fields: [targetUserId], references: [id])

  readBy       Json     // array of employee IDs who read it

  createdAt    DateTime @default(now())

  @@index([targetUserId])
  @@index([type])
}

model StockMovement {
  id              String   @id @default(cuid())

  productId       String
  productName     String   // denormalized for history integrity

  type            String   // sale | restock | damage | return | adjustment
  qtyChange       Int      // negative = out, positive = in
  qtyBefore       Int
  qtyAfter        Int

  relatedOrderId  String   @default("")
  note            String   @default("")
  changedBy       String   // username

  createdAt       DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  target    String   @default("")
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model Pet {
  id            String          @id @default(cuid())
  clientId      String
  client        ClientAccount   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  species       String
  breed         String          @default("")
  sex           String          @default("") // male | female | neutered_male | spayed_female
  dob           String          @default("") // YYYY-MM-DD
  weightKg      String          @default("")
  color         String          @default("")
  microchip     String          @default("")
  photo         String          @default("")
  notes         String          @default("")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  bookings      Booking[]
  prescriptions Prescription[]

  @@index([clientId])
}

model Prescription {
  id                String          @id @default(cuid())
  rxNumber          String          @unique
  verifyCode        String          @unique
  petId             String?
  pet               Pet?            @relation(fields: [petId], references: [id], onDelete: Cascade)
  clientId          String?
  client            ClientAccount?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  petName           String          @default("") // snapshot for walk-in patients without a pet file
  petSpecies        String          @default("")
  petBreed          String          @default("")
  doctorId          String
  doctor            Doctor          @relation(fields: [doctorId], references: [id])
  bookingId         String?
  booking           Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  diagnosis         String          @default("")
  items             Json            // [{medication, dose, frequency, route, duration, note}]
  instructions      String          @default("")
  followUpDate      String          @default("") // YYYY-MM-DD
  status            String          @default("issued") // draft | issued | void
  issuedAt          DateTime?
  signatureSnapshot Json?           // {name, title, licenseNumber, signatureImage} at time of issue
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([petId])
  @@index([clientId])
  @@index([doctorId])
  @@index([status])
}